rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Teachers profiles
    match /teachers/{teacherId} {
      allow read, write: if isSignedIn();
    }

    // Classes and all nested data (students, scores, attendance, honorPhotos, ptomRecords, invigilators)
    match /classes/{classId} {
      allow read, write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Report configurations
    match /reportConfigurations/{configId} {
      allow read, write: if isSignedIn();
    }

    // Global test document
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Fallback catch-all for signed in teachers
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
