        "classId": { "type": "string" },
        "lastName": { "type": "string" },
        "firstName": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string" },
        "age": { "type": "string" },
        "fatherName": { "type": "string" },
        "fatherJob": { "type": "string" },
